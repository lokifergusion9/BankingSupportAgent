# Copy this file to .env and fill it in. Never commit .env.

# Free key from https://console.groq.com -> API Keys
GROQ_API_KEY=

# Provider prefix + Groq model name. Needs tool calling and structured output.
GROQ_MODEL=groq:openai/gpt-oss-20b

# gpt-oss only: low (fast, fewer tokens), medium, high. Leave empty to use the model default.
GROQ_REASONING_EFFORT=low
